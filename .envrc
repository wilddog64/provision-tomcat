if [ -f ../.envrc ]; then
  source_up
else
  layout python3
fi

# Automated GitHub Secret Sync
# Syncs local sandbox credentials to GitHub whenever the environment is loaded
if command -v gh &>/dev/null && [ -x "../bin/sync-aws-secrets" ]; then
  # Only attempt sync if we have a valid/active AWS session
  if aws sts get-caller-identity &>/dev/null; then
    echo "--- AWS Sandbox Sync ---"
    "../bin/sync-aws-secrets"
  fi
fi
