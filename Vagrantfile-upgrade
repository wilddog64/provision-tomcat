# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "stromweld/windows-11"
  config.vm.communicator = "winrm"

  config.vm.provider "virtualbox" do |vb|
    vb.gui = false
    vb.memory = "8192"
    vb.cpus = 4
    
    # Secondary D: drive disk
    disk_file = File.join(Dir.pwd, ".kitchen", "data_disk_upgrade.vdi")
    unless File.exist?(disk_file)
      vbox_list = `VBoxManage list hdds 2>/dev/null`
      if vbox_list.include?(disk_file)
        uuid_match = vbox_list.match(/UUID:\s+([a-f0-9-]+).*?Location:\s+#{Regexp.escape(disk_file)}/m)
        if uuid_match
          uuid = uuid_match[1]
          # Check if disk is attached to any VM before closing
          attached_info = `VBoxManage showhdinfo #{uuid} 2>/dev/null`
          # If showhdinfo succeeded and shows disk is in use, skip cleanup
          if $?.success? && attached_info.match(/In use by VMs:\s+(\S+)/)
            puts "Disk #{disk_file} is in use, skipping internal management."
          else
            puts "Disk #{disk_file} exists in VirtualBox media registry but not on disk. Cleaning up..."
            `VBoxManage closemedium disk #{uuid} --delete 2>/dev/null`
          end
        end
      end
      vb.customize ['createhd', '--filename', disk_file, '--size', 50 * 1024]
    end
    
    # Note: storageattach will fail gracefully if disk is already attached,
    # so we don't need to pre-check. VirtualBox handles this case.
    vb.customize ['storageattach', :id, '--storagectl', 'SATA Controller', '--port', 1, '--device', 0, '--type', 'hdd', '--medium', disk_file]
  end

  common_env = {
    'env' => 'stage2',
    'extract_build_number' => 16,
    'extract_debug' => 'False',
    'skip_migration' => true,
    'ansible_connection' => 'winrm',
    'ansible_winrm_transport' => 'basic',
    'ansible_port' => 55985,
    'ansible_winrm_scheme' => 'http',
    'ansible_winrm_server_cert_validation' => 'ignore',
    'ansible_user' => 'vagrant',
    'ansible_password' => 'vagrant',
    'ansible_host' => '127.0.0.1',
    'ansible_become_method' => 'runas',
    'ansible_become_user' => 'vagrant',
    'install_drive' => 'D:'
  }

  config.vm.provision 'ansible_upgrade_step1', type: :ansible do |ansible|
    ansible.limit = 'all'
    ansible.galaxy_role_file = 'requirements.yml'
    ansible.playbook = 'tests/playbook-upgrade.yml'
    ansible.extra_vars = common_env.merge(
      'upgrade_step' => 1,
      'tomcat_auto_start' => true
    )
  end

  config.vm.network "forwarded_port", guest: 8080, host: 8080
  config.vm.network "forwarded_port", guest: 9080, host: 9080

  config.vm.provision 'ansible_upgrade_step2_prepare', type: :ansible, run: 'never' do |ansible|
    ansible.limit = 'all'
    ansible.galaxy_role_file = 'requirements.yml'
    ansible.playbook = 'tests/playbook-upgrade.yml'
    ansible.extra_vars = common_env.merge(
      'upgrade_step' => 2,
      'tomcat_auto_start' => true,
      'tomcat_candidate_enabled' => true,
      'tomcat_candidate_delegate' => 'localhost',
      'tomcat_candidate_manual_control' => true
    )
  end

  config.vm.provision 'ansible_upgrade_step2_finalize', type: :ansible, run: 'never' do |ansible|
    ansible.limit = 'all'
    ansible.galaxy_role_file = 'requirements.yml'
    ansible.playbook = 'tests/playbook-upgrade.yml'
    ansible.extra_vars = common_env.merge(
      'upgrade_step' => 2,
      'tomcat_auto_start' => true,
      'tomcat_candidate_enabled' => true,
      'tomcat_candidate_delegate' => 'localhost',
      'tomcat_candidate_manual_control' => false
    )
  end
end
